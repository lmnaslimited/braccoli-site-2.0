  "problemSolutionHeader": {
    "title": "Start with the problem.",
    "subtitle": "Start with the capability you need and expand when your business is ready.",
    "highlight": "Find your path.",
    "badge": "THE LMNAS WAY",
    "__typename": "ComponentCoreHeader"
  },
  "problemSolutionSection": {
    "mainProblems": [
      {
        "title": "Margin Leakage",
        "subtitle": null,
        "highlight": null,
        "badge": null,
        "subProblems": [
          {
            "title": "Discounts are difficult to control",
            "description": "Pricing decisions are spread across spreadsheets and disconnected workflows, so sales managers can’t see how far a discount cuts into the quoted margin.",
            "solutionTitle": "Bring pricing decisions under control",
            "solutionDescription": "LENS CPQ centralizes pricing and quotation workflows, so teams apply consistent pricing structures and see the margin behind every commercial decision.",
            "button": {
              "label": "Score Your Quoting Process (Coming Soon)",
              "href": null,
              "icon": null,
              "formMode": "booking",
              "description": null,
              "variant": "default",
              "__typename": "ComponentCoreButton"
            },
            "__typename": "ComponentSharedSubProblems"
          },
          {
            "title": "Slow quotes lose deals to faster rivals",
            "description": "A transformer quote passes through configuration, engineering validation, the bill of materials, pricing and approval. Buyers wait days and often sign with whoever replies first.",
            "solutionTitle": "Send accurate quotes faster",
            "solutionDescription": "LENS CPQ automates pricing rules and approval routing, so your team responds while the buyer is still deciding.",
            "button": {
              "label": "Read: Where Quotes Go Quiet",
              "href": null,
              "icon": null,
              "formMode": null,
              "description": null,
              "variant": "default",
              "__typename": "ComponentCoreButton"
            },
            "__typename": "ComponentSharedSubProblems"
          },
          {
            "title": "BOM errors travel from quote to shop floor",
            "description": "When quotes use outdated or hand-copied BOMs, wrong costs get sold and the rework shows up later in production.",
            "solutionTitle": "Quote from one trusted BOM",
            "solutionDescription": "LENS CPQ draws costs from a single maintained BOM, so what sales quotes matches what the plant builds.",
            "button": {
              "label": "Read: Five Handoffs, One Quote",
              "href": null,
              "icon": null,
              "formMode": null,
              "description": null,
              "variant": "default",
              "__typename": "ComponentCoreButton"
            },
            "__typename": "ComponentSharedSubProblems"
          },
          {
            "title": "Material costs move. Quotes do not.",
            "description": "When copper or steel prices change but price lists stay fixed, won deals quietly lose their margin.",
            "solutionTitle": "Price with current costs",
            "solutionDescription": "LENS CPQ links quotes to updated material costs, so every price reflects what the order will actually cost to deliver.",
            "button": {
              "label": "Estimate Your Margin Leak (Coming soon)",
              "href": null,
              "icon": null,
              "formMode": null,
              "description": null,
              "variant": "default",
              "__typename": "ComponentCoreButton"
            },
            "__typename": "ComponentSharedSubProblems"
          },
          {
            "title": "Complex tenders are priced on guesswork",
            "description": "Custom specs and long item lists make tenders hard to cost, so bids go out with margins nobody has verified.",
            "solutionTitle": "Know a tender's complexity before you bid",
            "solutionDescription": "LENS CPQ structures tender costing and approvals, helping teams price consistently and choose which bids are worth the effort.",
            "button": {
              "label": "Score a Tender (Coming Soon)",
              "href": null,
              "icon": null,
              "formMode": "booking",
              "description": null,
              "variant": "default",
              "__typename": "ComponentCoreButton"
            },
            "__typename": "ComponentSharedSubProblems"
          }
        ],
        "__typename": "ComponentSharedProblemSolutionSection"
      },
      {
        "title": "Production Slow",
        "subtitle": null,
        "highlight": null,
        "badge": null,
        "subProblems": [
          {
            "title": "The plan looks fine until the shop floor tries to follow it",
            "description": "Plans are built without live machine and labor limits, and wrong BOMs and routings stay hidden until work starts. Orders overlap, changeovers pile up, machines sit idle between jobs, and lines stop for errors planning missed.",
            "solutionTitle": "Plan against real capacity and catch errors early",
            "solutionDescription": "LENS IPS plans production against real capacity, helps planners group and sequence work to cut changeovers and idle time, and ties plans to maintained BOMs and routings, so issues surface during planning, not on the line.",
            "button": {
              "label": "Audit Your Production Plan (Coming Soon)",
              "href": null,
              "icon": null,
              "formMode": "booking",
              "description": null,
              "variant": "default",
              "__typename": "ComponentCoreButton"
            },
            "__typename": "ComponentSharedSubProblems"
          },
          {
            "title": "Materials arrive after production needs them",
            "description": "When procurement runs on spreadsheets and email follow-ups, a late tap changer or a short batch of core steel surfaces at the line, not at the planning desk. Teams then pay for premium freight and unplanned production to catch up.",
            "solutionTitle": "Plan procurement with production",
            "solutionDescription": "LENS IPS connects forecasts, procurement and production plans and tracks stock against demand across plants and warehouses, so shortages show up early enough to fix.",
            "button": {
              "label": "Read: When a late part idles the plant",
              "href": null,
              "icon": null,
              "formMode": null,
              "description": null,
              "variant": "default",
              "__typename": "ComponentCoreButton"
            },
            "__typename": "ComponentSharedSubProblems"
          },
          {
            "title": "Delays cost more than anyone tracks",
            "description": "Expedite fees, penalties and lost repeat orders sit in different teams, and wages, power and rent keep running while the machines wait.",
            "solutionTitle": "Put a number on delays",
            "solutionDescription": "Analytics Cloud brings delivery and cost data together, so leaders can see what late orders really cost.",
            "button": {
              "label": "Calculate the Cost of Late Orders (Coming soon)",
              "href": null,
              "icon": null,
              "formMode": null,
              "description": null,
              "variant": "default",
